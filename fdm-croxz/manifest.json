{
  "uuid": "fdm-croxz",
  "author": "Bugra",
  "name": "Croxz Universal Downloader",
  "description": "Downloads video and audio from YouTube, over 40 other sites and HLS (m3u8) streams through yt-dlp, with a choice of quality. Files such as .exe or .zip are left to FDM.",
  "version": "1.3.0",
  "icon": "icon.svg",
  "mediaParser": true,
  "mediaListParser": true,
  "scripts": [
    "msparser.js",
    "msbatchparser.js"
  ],
  "dependencies": {
    "Python": {"minVersion": "3.8"}
  },
  "permissions": [
    "launchPython"
  ],
  "allowedPaths": [
    "%LOCALAPPDATA%\\yt-dlp",
    "%APPDATA%\\yt-dlp",
    "%LOCALAPPDATA%\\croxz",
    "~/.config/yt-dlp",
    "~/.config/croxz"
  ],
  "minApiVersion": 6,
  "minFeaturesLevel": 1,
  "targetApiVersion": 9
}

